# Example .env file for GNN service
# Copy to .env and update with your values

# Device configuration
DEVICE=cuda

# Model parameters
HIDDEN_DIM=96
NUM_GAT_LAYERS=3
NUM_HEADS=4
LSTM_LAYERS=2
DROPOUT=0.12

# Temporal parameters
TIME_WINDOW_MINUTES=60
TIMESTEP_MINUTES=5

# Health thresholds
HEALTH_CRITICAL=0.3
HEALTH_WARNING=0.6

# Database (TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hydraulic_db
DB_USER=user
DB_PASSWORD=your_password_here

# API configuration
API_HOST=0.0.0.0
API_PORT=8001

# LLM/RAG configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# Redis (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# GNN INFERENCE ENGINE
# ============================================================================

# Timeouts (seconds)
GNN_INFERENCE_TIMEOUT_S=30.0
GNN_QUEUE_PUT_TIMEOUT_S=5.0
GNN_QUEUE_COLLECT_TIMEOUT_MS=50.0

# Batch processing
GNN_BATCH_SIZE=32
GNN_MAX_QUEUE_SIZE=100
GNN_ENABLE_DYNAMIC_BATCHING=false

# Model configuration
GNN_MODEL_PATH=/app/models/v2.0.0.ckpt
GNN_DEVICE=auto
GNN_FALLBACK_TO_CPU=true
GNN_ENABLE_COMPILE=true
GNN_PIN_MEMORY=true

# Features
GNN_USE_DYNAMIC_FEATURES=true
GNN_USE_DYNAMIC_BUILDER=true

# Topology & Caching
GNN_TOPOLOGY_TEMPLATES_PATH=/app/configs/topology_templates.json
GNN_TOPOLOGY_CACHE_SIZE=100
GNN_TOPOLOGY_CACHE_TTL_S=300.0

# Validation
GNN_VALIDATE_TENSORS=true

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_DIAGNOSE=10/minute
RATE_LIMIT_PREDICT=20/minute
RATE_LIMIT_STORAGE=memory://

# ============================================================================
# REQUEST SIZE LIMITS
# ============================================================================
MAX_REQUEST_SIZE_MB=10

# ============================================================================
# SENSOR DATA SOURCE CONFIGURATION (NEW - Phase 3.2)
# ============================================================================

# --- TimescaleDB Mock/Real Toggle ---
# Set USE_TIMESCALEDB_MOCK=true for development/testing without real database
# Set USE_TIMESCALEDB_MOCK=false for production with real TimescaleDB
USE_TIMESCALEDB_MOCK=true

# --- Real TimescaleDB Connection ---
# Used when USE_TIMESCALEDB_MOCK=false
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=hydraulic_diagnostics
TIMESCALEDB_USER=postgres
TIMESCALEDB_PASSWORD=your_password_here
TIMESCALEDB_POOL_SIZE=10
TIMESCALEDB_MAX_OVERFLOW=20

# --- Mock TimescaleDB Configuration ---
# Used when USE_TIMESCALEDB_MOCK=true
# Mock generates synthetic sensor data for testing
MOCK_TIMESCALEDB_SEED=42
MOCK_TIMESCALEDB_NOISE_LEVEL=0.05

# --- CSV Data Source Configuration ---
# Directory containing CSV files with sensor data
CSV_DATA_DIR=./data/sensor_readings
CSV_TIMESTAMP_FORMAT=%Y-%m-%dT%H:%M:%S%z

# --- REST API Data Source Configuration ---
# Base URL for REST API sensor endpoints
API_BASE_URL=http://localhost:8080/api/v1
API_TIMEOUT_SECONDS=5
API_MAX_RETRIES=3

# ============================================================================
# SENSOR CONFIGURATION
# ============================================================================

# Default sensor sampling rates (Hz)
DEFAULT_PRESSURE_SAMPLING_RATE=10.0
DEFAULT_FLOW_SAMPLING_RATE=5.0
DEFAULT_TEMPERATURE_SAMPLING_RATE=1.0
DEFAULT_RPM_SAMPLING_RATE=1.0

# ============================================================================
# VALUE SUBSTITUTION ENGINE (Physics-based estimation)
# ============================================================================

# Enable/disable physics-based value substitution
ENABLE_VALUE_SUBSTITUTION=true

# Darcy-Weisbach equation parameters
# Fluid properties (ISO VG 46 hydraulic oil at 40°C)
FLUID_DENSITY_KG_M3=870.0
FLUID_VISCOSITY_PAS=0.046

# Material roughness (mm) for pressure drop calculation
MATERIAL_ROUGHNESS_STEEL=0.045
MATERIAL_ROUGHNESS_RUBBER=0.15
MATERIAL_ROUGHNESS_COMPOSITE=0.1

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
