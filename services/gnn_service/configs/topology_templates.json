{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shukik85/hydraulic-diagnostic-saas/topology-templates.schema.json",
  "title": "Hydraulic Topology Templates",
  "description": "Built-in templates for common hydraulic system configurations. Used by InferenceEngine for topology caching and graph construction. Compatible with UniversalTemporalGNNv2 v2.0.2.",
  "version": "2.0.0",
  "_documentation": {
    "overview": "This file contains pre-defined hydraulic system topologies for common equipment configurations. Templates are used to instantiate graph structures for GNN inference without querying external topology services.",
    "usage": {
      "api_request": "POST /v1/diagnose with 'topology_id' parameter (e.g., 'standard_pump_system')",
      "python_code": "from src.services.topology_service import TopologyService; topology = TopologyService.get_template('dual_pump_system')",
      "caching": "Templates are cached by InferenceEngine with 300s TTL (configurable via TOPOLOGY_CACHE_TTL_S)"
    },
    "template_structure": {
      "template_id": "Unique identifier (used in API requests)",
      "name": "Human-readable name",
      "description": "Detailed description of system configuration",
      "version": "Template version (semantic versioning)",
      "category": "mobile_hydraulics | industrial_hydraulics | custom",
      "components": "Array of hydraulic components (nodes in graph)",
      "edges": "Array of connections between components (edges in graph)"
    },
    "component_schema": {
      "component_id": "Unique identifier within template",
      "component_type": "pump | filter | valve | cylinder | cooler | reservoir | motor | accumulator",
      "name": "Component name",
      "manufacturer": "Manufacturer name (e.g., 'Bosch Rexroth', 'Parker', 'HYDAC')",
      "model": "Model number",
      "additional_fields": "Type-specific fields (e.g., rated_pressure_bar for pumps)"
    },
    "edge_schema": {
      "source_id": "Source component_id",
      "target_id": "Target component_id",
      "edge_type": "pipe | hose | rigid",
      "diameter_mm": "Inner diameter in millimeters",
      "length_m": "Length in meters",
      "material": "steel | rubber | plastic",
      "pressure_rating_bar": "Maximum pressure rating in bar",
      "temperature_rating_c": "Maximum temperature rating in Celsius (optional)"
    },
    "validation": {
      "rules": [
        "All component_ids must be unique within a template",
        "Edge source_id and target_id must reference existing component_ids",
        "Edge diameter_mm must be > 0 and <= 100",
        "Edge length_m must be > 0 and <= 50",
        "Component rated_pressure_bar should match edge pressure_rating_bar"
      ],
      "compatibility": "Templates are validated against UniversalTemporalGNNv2 requirements (34D node features, 14D edge features)"
    },
    "production_notes": {
      "graph_construction": "Each component becomes a node with 34D features (sensor readings + metadata). Each edge becomes a connection with 14D features (8D static + 6D dynamic).",
      "missing_sensors": "If sensor readings are missing, TwoStageImputer (spatial + temporal) is used for imputation.",
      "performance": "Template loading is O(1) from cache. First access triggers cache miss (50-100ms), subsequent accesses are <1ms."
    },
    "examples": {
      "standard_pump_system": "Use for: excavators, loaders, basic mobile hydraulics. 4 components, linear topology.",
      "dual_pump_system": "Use for: redundant systems, high-reliability industrial applications. 7 components, parallel topology.",
      "hydraulic_circuit_type_a": "Use for: temperature-controlled industrial systems, cooling required. 5 components, closed-loop topology."
    }
  },
